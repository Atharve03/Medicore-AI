# Base URL the frontend calls for the API. Left as /api/v1 by default so
# Vite's dev-server proxy (see vite.config.js) forwards to the backend
# without needing CORS configuration during local development.
VITE_API_BASE_URL=/api/v1

# Used only by vite.config.js's dev-server proxy target, not by the app
# code itself.
VITE_API_PROXY_TARGET=http://localhost:5000
