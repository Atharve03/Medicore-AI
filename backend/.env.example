# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/medicore_ai

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=changeme_password_reset_secret
JWT_PASSWORD_RESET_EXPIRES_IN=10m

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Email (Notification module)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Hybrid AI Configuration ----
# One of: local | openai | claude | gemini
AI_PROVIDER=local

# Local provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
AI_HISTORY_LIMIT=10

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
